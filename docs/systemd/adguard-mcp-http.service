[Unit]
Description=AdGuard MCP HTTP server
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/adguardctrl
ExecStart=/usr/bin/node /opt/adguardctrl/dist/mcp-server.js --http
EnvironmentFile=%h/.config/adguard-mcp/http.env
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
